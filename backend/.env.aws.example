# Plantilla: guardar valores reales fuera del repo, en /etc/ecoraee/backend.env.
# Codificar caracteres especiales del usuario/contraseña en la URL.
ECORAEE_DB_URL=mssql+pyodbc://ecoraee_app:CAMBIAR@ENDPOINT_RDS:1433/ecoraee_cloud?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
ECORAEE_CORS_ORIGINS=https://FRONTEND.cloudfront.net
ECORAEE_JWT_SECRET=CAMBIAR
ECORAEE_STORAGE=s3
ECORAEE_S3_BUCKET=BUCKET_EVIDENCIAS
AWS_REGION=us-east-1
ECORAEE_EVIDENCE_MAX_BYTES=10485760
ECORAEE_DB_POOL_SIZE=5
ECORAEE_DB_MAX_OVERFLOW=5
ECORAEE_DB_POOL_TIMEOUT=30
ECORAEE_DB_POOL_RECYCLE=1800
